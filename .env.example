# Copy to .env and export, or set in your shell. Names only; never commit values.

# Generation and vision: Muse Spark 1.3 on the Meta Model API (OpenAI chat
# completions protocol; text, image, and PDF input; JSON schema output).
# Any OpenAI-compatible endpoint works the same way: Modal, Baseten, and
# Fireworks all expose one. Check with `python -m policyqa.cli smoke`.
POLICYQA_LLM_BASE_URL=https://api.meta.ai/v1
POLICYQA_LLM_API_KEY=
POLICYQA_LLM_MODEL=muse-spark-1.3
POLICYQA_LLM_INPUT_USD_PER_M=1.25   # Muse Spark 1.3 list price per million input tokens (dev.meta.ai Models page, Oct 26, 2026)
POLICYQA_LLM_OUTPUT_USD_PER_M=4.25  # per million output tokens; completion tokens include reasoning tokens

# Judge: Claude. The SDK also accepts an `ant auth login` profile instead of a key.
ANTHROPIC_API_KEY=
POLICYQA_JUDGE_MODEL=claude-opus-5-5

# Optional. Muse Spark 1.3 is a reasoning model; its thinking is billed as output. If the endpoint
# accepts reasoning_effort (check with `python -m policyqa.cli smoke --effort low --raw`), setting
# this to low cuts latency and cost per case. Left unset, nothing is sent.
POLICYQA_LLM_REASONING_EFFORT=

# Optional. Where the API keeps cases between restarts (one JSON file per case). Default data/cases
# under the repo; set to an empty string for memory only.
RECOURSE_CASE_DIR=

# Open-weights endpoints for the Muse Spark Open comparison (`case-evals` with the three
# POLICYQA_LLM_* values above pointed at one of these). Holders only; the run copies one of them into
# POLICYQA_LLM_API_KEY. Both credits were issued and both keys were smoke-tested on Oct 27, 2026.
BASETEN_API_KEY=            # base URL https://inference.baseten.co/v1, model meta-models/muse-spark-open-1026
FIREWORKS_API_KEY=          # base URL https://api.fireworks.ai/inference/v1, model accounts/fireworks/models/muse-spark-open (3.6 s, $0.0003 a smoke call)

# Modal, for the deploy (deploy/README.md). An API token created in the Modal dashboard (Settings,
# API Tokens); the `modal` package reads these two names, so no `modal token new` is needed.
MODAL_TOKEN_ID=             # starts with ak-
MODAL_TOKEN_SECRET=         # starts with as-

# Optional. HTTP timeout in seconds for every model call (default 120). The open-weights endpoints take
# 170 s and more on the verdict stage; set 300 for a case-evals run against Fireworks or Baseten.
POLICYQA_LLM_TIMEOUT_S=

# Optional. Second opinion: the verdict stage run again on Muse Spark Open; it never changes the verdict.
# Unset base URL or model means skipped. Comments sit above each name: scripts/dev-api.ps1 keeps a same-line comment as the value.
# Base URL: Baseten https://inference.baseten.co/v1, or Fireworks https://api.fireworks.ai/inference/v1
POLICYQA_SECOND_LLM_BASE_URL=
# Model: Baseten meta-models/muse-spark-open-1026, or Fireworks accounts/fireworks/models/muse-spark-open
POLICYQA_SECOND_LLM_MODEL=
# That endpoint's key (BASETEN_API_KEY or FIREWORKS_API_KEY's value); never falls back to POLICYQA_LLM_API_KEY
POLICYQA_SECOND_LLM_API_KEY=
# Price per million input tokens; unset means the primary's POLICYQA_LLM_INPUT_USD_PER_M
POLICYQA_SECOND_LLM_INPUT_USD_PER_M=
# Price per million output tokens; unset means the primary's POLICYQA_LLM_OUTPUT_USD_PER_M
POLICYQA_SECOND_LLM_OUTPUT_USD_PER_M=
