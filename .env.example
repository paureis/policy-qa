# Copy to .env and export, or set in your shell. Names only; never commit values.

# Generation: an open-weights Meta model behind an OpenAI-compatible endpoint.
# Modal, Baseten, and Fireworks all expose one. Fill in whichever host the
# hackathon credits land on.
POLICYQA_LLM_BASE_URL=        # e.g. https://api.fireworks.ai/inference/v1
POLICYQA_LLM_API_KEY=
POLICYQA_LLM_MODEL=           # e.g. accounts/fireworks/models/llama-v3p3-70b-instruct
POLICYQA_LLM_INPUT_USD_PER_M=   # price per million input tokens, for cost per query
POLICYQA_LLM_OUTPUT_USD_PER_M=

# Judge: Claude. The SDK also accepts an `ant auth login` profile instead of a key.
ANTHROPIC_API_KEY=
POLICYQA_JUDGE_MODEL=claude-opus-5-5
